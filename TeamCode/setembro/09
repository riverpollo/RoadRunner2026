@TeleOp(name="DriveTest", group="TeleOpMode")
public class DriveTest extends LinearOpMode {


    private Drive drive;
    private Intake intake;


    @Override
    public void runOpMode() {
        intake = new Intake(hardwareMap, telemetry);
        drive = new Drive(hardwareMap, telemetry);

        waitForStart();
        while (opModeIsActive()) {
            drive.run(-gamepad1.left_stick_x, gamepad1.left_stick_y, -gamepad1.right_stick_x ,gamepad1.right_bumper, -gamepad2.right_stick_x);
            intake.run( gamepad1.a,gamepad1.b,gamepad1.x);
            intake.sendTelemetry();
            drive.sendTelemetry();
            telemetry.update();
